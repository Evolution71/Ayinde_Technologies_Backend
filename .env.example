# Copy this file to .env before running.

PORT=8000

# Leave unset to use local SQLite (ayinde.db, created automatically).
# Set to a Postgres URL (e.g. what Railway gives you) for production.
# DATABASE_URL=postgresql://user:password@host:5432/ayinde_db

# REQUIRED before deploying — used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this is left unset, the app runs with an insecure default and prints a
# warning — fine for a quick local test, never for anything real.
SECRET_KEY=

# How long a login stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend URL here once you have one, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://www.ayindetechnologies.com
ALLOWED_ORIGINS=http://localhost:3000

# Payments (Flutterwave) — optional. Leave both unset and the site runs
# completely fine: courses, trials, and enrollment all still work, and the
# "pay to continue" button shows a friendly "not available yet" message
# instead of breaking. Fill these in once you have a Flutterwave account
# (dashboard.flutterwave.com) to turn on real payments — no code changes
# needed, just restart the server after adding them.
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxx-X
# FLUTTERWAVE_SECRET_HASH=choose-your-own-random-webhook-secret
